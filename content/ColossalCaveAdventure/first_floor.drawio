        <mxCell id="hb2w6sNIWQN-Vbbioqjq-327" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;b&gt;85&lt;/b&gt;" vertex="1">
