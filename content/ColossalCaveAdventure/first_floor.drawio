        </mxCell>
        <mxCell id="hb2w6sNIWQN-Vbbioqjq-331" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;b&gt;83&lt;/b&gt;" vertex="1">
