        <mxCell id="Np7i9czIo3OInyWtCf3--1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Demo of how the travel table works with 7.&lt;div&gt;Show original data and decoded data. Discuss sets&lt;/div&gt;&lt;div&gt;of words. Show how &quot;DOW&quot; for slit is shadowed (Woods fixes this).&lt;/div&gt;&lt;div&gt;Discuss the &quot;You don&#39;t fit&quot; room and show that decoded. Woods enhanced the travel info to allow for print and stay. Discuss later.&lt;/div&gt;" vertex="1">
          <mxGeometry height="125.74" width="370" x="1290" y="2545.6000000000004" as="geometry" />
        </mxCell>
        <mxCell id="Np7i9czIo3OInyWtCf3--2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Discuss magid words for quick travel" vertex="1">
          <mxGeometry height="56.92" width="134.75" x="1270" y="2232.83" as="geometry" />
        </mxCell>
        <mxCell id="Np7i9czIo3OInyWtCf3--3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="FOOD and WATER don&#39;t do anything (Woods will change). No &quot;inventory&quot; system to see what you have. But you can still drop/get." vertex="1">
          <mxGeometry height="91" width="180" x="1270" y="2399.01" as="geometry" />
        </mxCell>
        <mxCell id="Ni6yOytRqafV4diOJAIe-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="The BACK is caught and handled by the code. They are useless here.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;For instance, BACK in room 5 travel table executes s300 to either 5 or 6. But the code takes you back to the last room (try coming from 01 and then BACK)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Woods removes the BACK words&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="186.08" width="230" x="1190" y="1965.26" as="geometry" />
        </mxCell>
